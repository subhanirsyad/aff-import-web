# Salin jadi secrets.toml (lokal) atau tempel ke menu Secrets di Streamlit Cloud. JANGAN di-commit.

allowed_emails = []   # email di luar domain perusahaan yang tetap boleh masuk, misal ["nama@gmail.com"] (harus di atas semua [tabel])

[auth]
redirect_uri = "https://NAMA-APP.streamlit.app/oauth2callback"   # lokal: http://localhost:8501/oauth2callback
cookie_secret = "isi-string-acak-panjang"
client_id = "ISI-OAUTH-CLIENT-ID.apps.googleusercontent.com"
client_secret = "ISI-OAUTH-CLIENT-SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[gcp_service_account]   # isi persis dari credentials.json (service account yang punya akses Editor ke 2 sheet)
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"
